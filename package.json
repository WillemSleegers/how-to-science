{
  "name": "how-to-science",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/render.mjs --watch & astro dev",
    "build": "node scripts/render.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,astro}\"",
    "typecheck": "astro check",
    "render": "node scripts/render.mjs",
    "cleanup": "find src/content -name '*-gfm.md' -delete"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.8.3",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "^1.4.0"
  },
