---
import Layout from "@/layouts/main.astro"
import { ThemeToggle } from "@/components/ThemeToggle"
import { loadNav, slugify } from "@/lib/nav"

const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const nav = loadNav()

// Group each section's pages into labelled blocks (sub-group label + its pages),
// with any direct top-level pages collected into a final unlabelled block.
const sections = nav.map((section) => {
  const groups = section.nodes
    .filter((n) => !n.slug)
    .map((n) => ({ label: n.title, pages: n.children.filter((c) => c.slug) }))
    .filter((g) => g.pages.length > 0)
  const directs = section.nodes.filter((n) => n.slug)
  const blocks = [...groups, ...(directs.length ? [{ label: null, pages: directs }] : [])]
  return { title: section.title, blocks }
})
---

<Layout title="How to Science">
  <div class="mx-auto max-w-5xl px-6 py-12 lg:px-8 lg:py-16">
    <section class="mb-14">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">How to Science</h1>
      <p class="mt-4 text-base text-muted-foreground">
        Notes on methodology and statistics, including literature reviews and R code. A work in progress — spotted a mistake or disagree with something? <a
          href="https://github.com/WillemSleegers/how-to-science/issues"
          class="font-medium text-primary underline-offset-4 hover:underline">Open an issue</a
        > or <a
          href="https://www.willemsleegers.com"
          class="font-medium text-primary underline-offset-4 hover:underline">get in touch</a
        >.
      </p>
    </section>

    {
      sections.map((section) => (
        <section id={slugify(section.title)} class="mb-14 scroll-mt-4">
          <h2 class="mb-3 text-lg font-semibold tracking-tight">{section.title}</h2>
          <div class="space-y-6">
          {section.blocks.map((block) => (
            <div id={block.label ? slugify(block.label) : undefined} class={block.label ? "scroll-mt-4" : undefined}>
              {block.label && (
                <h3 class="mb-2.5 text-sm font-medium text-muted-foreground">
                  {block.label}
                </h3>
              )}
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {block.pages.map((page) => (
                  <a
                    href={`${base}/${page.slug}`}
                    class="group flex flex-col rounded-lg border bg-card p-4 transition-colors hover:bg-muted/50"
                  >
                    <span class="text-sm font-medium">{page.title}</span>
                    {page.description && (
                      <span class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">
                        {page.description}
                      </span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          ))}
          </div>
        </section>
      ))
    }

    <div class="mt-4 flex justify-center pt-8">
      <ThemeToggle client:load />
    </div>
  </div>
</Layout>
